{
  "name": "rednote-steward",
  "version": "0.1.0",
  "description": "Local publishing and account operations for Xiaohongshu, with a shared CLI and MCP server.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaofeng21cn/rednote-steward.git"
  },
