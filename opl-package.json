{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "rednote-steward",
    "version": "0.2.11",
    "intent": "extension",
    "name": {
      "zh-CN": "RedNote Steward",
      "en-US": "RedNote Steward"
    },
    "summary": {
      "zh-CN": "通过统一的本地 CLI 和 MCP 服务准备、审阅并管理小红书内容发布。",
      "en-US": "Prepare, review and manage Xiaohongshu publications through one local CLI and MCP service."
    },
    "routing_summary": {
      "zh-CN": "检查发布队列、审阅准确内容、维护已有笔记，并从同一任务恢复执行。",
      "en-US": "Inspect the publication queue, review exact content, maintain existing posts and resume the same task."
    },
    "publisher": "gaofeng21cn",
    "license": "Apache-2.0",
    "icon": "assets/branding/rednote-steward-logo-v2.png",
    "repository": "https://github.com/gaofeng21cn/rednote-steward"
  },
  "dependencies": {
    "opl_base": "^2.0.0",
    "runtimes": [
      {
        "name": "node",
        "version": ">=24"
      }
    ]
  },
  "provides": {
    "module_ids": [
      "rednote.steward.v1"
    ],
    "cli_bin": [
      {
        "name": "xhs-ops",
        "path": "./src/cli.mjs"
      },
      {
        "name": "rednote-steward-mcp",
        "path": "./src/mcp.mjs"
      }
    ],
    "skills": [
      {
        "id": "rednote-steward",
        "path": "./skills/rednote-steward",
        "exposure": "default"
      }
    ],
    "mcp_servers": [
      {
        "id": "rednote-steward",
        "transport": "stdio",
        "command": "node",
        "args": [
          "./scripts/run-plugin.mjs",
          "mcp"
        ]
      }
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "node",
        "./scripts/run-plugin.mjs",
        "app-contribution"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "rednote.steward.tasks",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "workspace",
          "title": {
            "en-US": "Publication tasks",
            "zh-CN": "发布任务"
          },
          "data_ref": "rednote.steward.v1#tasks",
          "sort_order": 800
        },
        {
          "id": "rednote.steward.review",
          "view_type": "approval_diff",
          "slot": "settings.section",
          "settings_destination": "workspace",
          "title": {
            "en-US": "Exact content review",
            "zh-CN": "精确内容审阅"
          },
          "data_ref": "rednote.steward.v1#review",
          "sort_order": 801
        },
        {
          "id": "rednote.steward.media",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "workspace",
          "title": {
            "en-US": "Frozen task media",
            "zh-CN": "任务素材"
          },
          "data_ref": "rednote.steward.v1#media",
          "sort_order": 802
        },
        {
          "id": "rednote.steward.catalog",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "workspace",
          "title": {
            "en-US": "Account assets",
            "zh-CN": "账号资产"
          },
          "data_ref": "rednote.steward.v1#catalog",
          "sort_order": 803
        },
        {
          "id": "rednote.steward.history",
          "view_type": "activity_log",
          "slot": "settings.section",
          "settings_destination": "workspace",
          "title": {
            "en-US": "Metric history",
            "zh-CN": "指标历史"
          },
          "data_ref": "rednote.steward.v1#history",
          "sort_order": 804
        },
        {
          "id": "rednote.steward.recovery",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "workspace",
          "title": {
            "en-US": "Recovery queue",
            "zh-CN": "恢复队列"
          },
          "data_ref": "rednote.steward.v1#recovery",
          "sort_order": 805
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/rednote-steward",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": false
    }
  }
}
